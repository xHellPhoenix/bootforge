{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && cargo build --release --locked -p sealflash-flash-helper"
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "resources": {
      "../THIRD-PARTY.md": "licenses/THIRD-PARTY.md"
    },
    "linux": {
      "deb": {
        "depends": ["pkexec | policykit-1", "wimtools"],
        "files": {
          "/usr/lib/sealflash/sealflash-flash-helper": "../target/release/sealflash-flash-helper",
          "/usr/share/polkit-1/actions/io.github.xhellphoenix.sealflash.policy": "../packaging/linux/io.github.xhellphoenix.sealflash.policy"
        }
      },
      "rpm": {
        "depends": ["polkit", "wimlib-utils"],
        "files": {
          "/usr/lib/sealflash/sealflash-flash-helper": "../target/release/sealflash-flash-helper",
          "/usr/share/polkit-1/actions/io.github.xhellphoenix.sealflash.policy": "../packaging/linux/io.github.xhellphoenix.sealflash.policy"
        }
      }
    }
  }
}
